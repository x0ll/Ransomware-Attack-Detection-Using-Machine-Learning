# ============================================================
# 🔒 SARMZ RansomGuard — Comprehensive .gitignore
# ============================================================

# ──────────────────────────────────────────────
# 🔑 ENVIRONMENT & SECRETS — NEVER COMMIT THESE
# ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
secrets.json
config.secret.*
*.secret
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# ──────────────────────────────────────────────
# 🗄️ DATABASES
# ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/ransomguard.db

# ──────────────────────────────────────────────
# 🐍 PYTHON
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ──────────────────────────────────────────────
# 📦 NODE / FRONTEND
# ──────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# ──────────────────────────────────────────────
# 🧠 MACHINE LEARNING MODELS (large binaries — optional)
# ──────────────────────────────────────────────
# Uncomment the lines below if you do NOT want to track .pkl model files
# backend/models/*.pkl

# ──────────────────────────────────────────────
# 📊 LARGE DATASETS
# ──────────────────────────────────────────────
backend/datasets/*.csv
backend/datasets/*.xlsx
backend/datasets/*.parquet

# ──────────────────────────────────────────────
# 🖥️ OS & EDITOR JUNK
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.user
*.workspace
.project

# ──────────────────────────────────────────────
# 📋 LOGS
# ──────────────────────────────────────────────
*.log
logs/
backend/logs/
training_log.json

# ──────────────────────────────────────────────
# 🔐 SENSITIVE SCRIPTS / TOKENS
# ──────────────────────────────────────────────
import\ qrcode.py
generate_tree.py
trust_but_verify.py